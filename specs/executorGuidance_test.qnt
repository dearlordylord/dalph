module executorGuidanceTest {
  import executorGuidance.* from "./executorGuidance"
  run oversizedRefusalPreservesIdentityTest = initWithFaults(true).then(admit(1, 1, 3)).then(selectTurn(1))
    .expect(oversizedRefusalReached and oversizedCannotTransmit)
    .then(admit(1, 1, 1)).expect(contradictionReached and state.receipts.get(1).calls == 0)
  run selectedTurnAcceptedOnceTest = initWithFaults(true).then(admit(1, 1, 1)).then(selectTurn(1)).then(dispatch(1))
    .then(acknowledge(1, true, true)).then(admit(1, 1, 1))
    .expect(state.receipts.get(1).disposition == InputAccepted and sendsAreBounded and exactTurnOnly)
  run independentAttemptsTest = initWithFaults(true).then(admit(1, 1, 1)).then(admit(2, 2, 2))
    .then(selectTurn(1)).then(selectTurn(2)).then(dispatch(1)).then(dispatch(2))
    .expect(independentAttemptsReached and exactTurnOnly)
  run completionAfterSelectionRefusesWithoutRetargetingTest = initWithFaults(true).then(admit(1, 1, 1)).then(selectTurn(1))
    .then(finishTurn(1)).then(dispatch(1))
    .expect(state.receipts.get(1).calls == 0 and state.receipts.get(1).disposition == Refused)
  run lostAcknowledgementNeverResendsTest = initWithFaults(true).then(admit(1, 1, 1)).then(selectTurn(1)).then(dispatch(1))
    .then(acknowledge(1, true, false)).then(admit(1, 1, 1))
    .expect(state.receipts.get(1).disposition == Unknown and state.receipts.get(1).calls == 1)
  run foreignAcknowledgementIsUnknownTest = initWithFaults(true).then(admit(1, 1, 1)).then(selectTurn(1)).then(dispatch(1))
    .then(acknowledge(1, false, true)).expect(unknownReached)
  run lostUnsentTextIsNotReconstructedTest = initWithFaults(true).then(admit(1, 1, 1)).then(crash).then(recover)
    .then(admit(1, 1, 1)).then(reconcile(1))
    .expect(payloadLostReached and state.receipts.get(1).calls == 0)
  run crashAfterIntentIsUncertainEvenWithoutObservedCallTest = initWithFaults(true).then(admit(1, 1, 1)).then(selectTurn(1))
    .then(crash).then(recover).then(reconcile(1))
    .expect(unknownReached and state.receipts.get(1).calls == 0 and lostTextCannotProveNoTransmission)
  run crashAfterTransmissionDoesNotReplayTest = initWithFaults(true).then(admit(1, 1, 1)).then(selectTurn(1)).then(dispatch(1))
    .then(crash).then(recover).then(reconcile(1)).then(admit(1, 1, 1))
    .expect(unknownReached and state.receipts.get(1).calls == 1)
  run conflictingPayloadOrAttemptCannotReplaceMetadataTest = initWithFaults(true).then(admit(1, 1, 1)).then(admit(1, 1, 2))
    .expect(contradictionReached and state.receipts.get(1).digest == 1)
    .then(admit(1, 2, 1)).expect(contradictionReached and state.receipts.get(1).attempt == 1)
  run unavailableOwnersAndCapabilitiesCannotSendTest = initWithFaults(true).then(admit(1, 1, 1)).then(loseCustody(1))
    .then(selectTurn(1)).expect(refusedReached and state.receipts.get(1).calls == 0)
  run acceptedInputSurvivesCompletionTest = initWithFaults(true).then(admit(1, 1, 1)).then(selectTurn(1)).then(dispatch(1))
    .then(finishTurn(1)).then(acknowledge(1, true, true)).expect(acceptedReached and exactTurnOnly)
  run existingAdmittedEffectMayFinishAfterExitCutoffTest = initWithFaults(true).then(admit(1, 1, 1)).then(selectTurn(1))
    .then(closeAdmission).then(dispatch(1)).then(acknowledge(1, true, true))
    .expect(acceptedReached and closedAdmissionReached)

}
