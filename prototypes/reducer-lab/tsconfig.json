{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@dalph/contracts": ["../../packages/contracts/src/index.ts"],
      "@dalph/orchestrator": ["../../packages/orchestrator/src/index.ts"],
      "effect": ["../../node_modules/effect"],
      "effect/*": ["../../node_modules/effect/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["vite/client"]
  },
  "include": [
    "src/cassette-lab.ts",
    "src/cassette-lab-browser.ts",
    "src/cassette-lab-view.ts",
    "src/cassette-lab.smoke.ts",
    "src/trace-cursor-selection.test.ts",
    "src/trace-cursor-selection.ts",
    "src/continuation-authorization-lab.test.ts",
    "src/entry.ts",
    "src/node-only-module-shim.ts",
    "src/platform-node-shim.ts",
    "vite.config.ts"
  ]
}
