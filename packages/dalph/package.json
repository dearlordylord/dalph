{
  "name": "@dalph/dalph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "dalph": "dist/bin/dalph.js",
    "dalph-linux-exit-host-fixture": "dist/bin/linux-application-exit-host-fixture.js",
    "dalph-codex-qualification-host": "dist/bin/codex-qualification-host.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
