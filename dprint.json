{
  "oxc": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "semicolons": "asNeeded",
    "quoteStyle": "double",
    "trailingCommas": "none",
    "expand": "never"
  },
  "includes": [
    "src/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/coverage",
    "**/prototypes"
  ],
  "plugins": [
    "https://plugins.dprint.dev/oxc-0.32.0.wasm"
  ]
}
