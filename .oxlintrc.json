{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import"],
  "jsPlugins": ["./scripts/oxlint-project-plugin.mjs"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "**/coverage",
    "**/dist",
    "**/node_modules",
    "**/prototypes",
    "**/test/fixtures",
    "**/*.md"
  ],
  "rules": {
    "no-array-constructor": "error",
    "no-unused-expressions": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-var": "error",
    "object-shorthand": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "typescript/array-type": [
      "error",
      {
        "default": "generic",
        "readonly": "generic"
      }
    ],
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/triple-slash-reference": "error",
    "import/first": "error",
    "import/no-duplicates": "error",
    "import/no-nodejs-modules": "error",
    "max-lines": [
      "error",
      {
        "max": 420,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "no-console": "error",
    "no-magic-numbers": [
      "error",
      {
        "enforceConst": true,
        "ignore": [0, 1, 1024],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "crypto",
        "message": "Inject the crypto capability through an Effect service instead of using its ambient global."
      },
      {
        "name": "fetch",
        "message": "Inject the fetch capability through an Effect service instead of using its ambient global."
      },
      {
        "name": "globalThis",
        "message": "Inject the globalThis capability through an Effect service instead of using its ambient global."
      },
      {
        "name": "performance",
        "message": "Inject the performance capability through an Effect service instead of using its ambient global."
      },
      {
        "name": "process",
        "message": "Inject the process capability through an Effect service instead of using its ambient global."
      },
      {
        "name": "setInterval",
        "message": "Inject the setInterval capability through an Effect service instead of using its ambient global."
      },
      {
        "name": "setTimeout",
        "message": "Inject the setTimeout capability through an Effect service instead of using its ambient global."
      }
    ],
    "dalph/effect-class-inheritance-only": "error",
    "dalph/no-ambient-capability-bypass": "error",
    "dalph/no-clock-read": "error",
    "dalph/no-module-mocks": "error",
    "dalph/no-type-assertion": "error",
    "dalph/require-canonical-effect-import": "error",
    "dalph/sort-destructure-keys": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}", "packages/*/src/**/*.{ts,tsx}"],
      "rules": {
        "dalph/no-throw-statement": "error"
      }
    },
    {
      "files": ["vitest.config.ts"],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": ["packages/dalph/src/**/*.ts"],
      "rules": {
        "dalph/no-restricted-import-path": [
          "error",
          {
            "patterns": [
              {
                "pattern": "coordination/(?:activation|delivery|frontier|run)/",
                "message": "Reach coordination through the @dalph/orchestrator package boundary instead of its internal modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/orchestrator/src/coordination/delivery/run-delivery-runtime.ts"],
      "rules": {
        "dalph/no-restricted-import-path": [
          "error",
          {
            "patterns": [
              {
                "pattern": "^\\./ticket-delivery-projection",
                "message": "The runtime consumer stays independent of domain projection implementations; take projections through the relation services."
              },
              {
                "pattern": "^\\.\\./(?:frontier/(?:frontier|fresh-facts|integration-frontier|recovery|recovery-frontier)|reconstruction|run/fresh-workflow)",
                "message": "The runtime consumer stays independent of frontier, reconstruction, and fresh-workflow derivation; take them through the relation services."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/orchestrator/src/cli.test.ts"],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "rules": {
        "dalph/no-double-type-assertion": "error",
        "dalph/no-throw-statement": "off",
        "dalph/no-type-assertion": "off",
        "max-lines": "off",
        "no-magic-numbers": "off",
        "typescript/no-non-null-assertion": "warn",
        "typescript/no-unnecessary-type-assertion": "off"
      }
    },
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "excludeFiles": ["**/*.property.test.ts"],
      "rules": {
        "dalph/property-test-placement": "error"
      }
    },
    {
      "files": ["scripts/**/*.{ts,tsx,mjs}"],
      "rules": {
        "dalph/effect-class-inheritance-only": "off",
        "dalph/no-ambient-capability-bypass": "off",
        "dalph/no-throw-statement": "off",
        "import/no-nodejs-modules": "off",
        "max-lines": "off",
        "no-console": "off",
        "no-magic-numbers": "off",
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["packages/**/scripts/**/*.{js,mjs,ts,tsx}"],
      "rules": {
        "dalph/effect-class-inheritance-only": "off",
        "dalph/no-ambient-capability-bypass": "off",
        "dalph/no-throw-statement": "off",
        "import/no-nodejs-modules": "off",
        "max-lines": "off",
        "no-console": "off",
        "no-magic-numbers": "off",
        "no-restricted-globals": "off"
      }
    }
  ]
}
