{
  "name": "@dalph/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0",
    "pnpm": ">=10.29.0"
  },
  "scripts": {
    "prepare": "husky && effect-tsgo patch --typescript-package @typescript/native",
    "build": "pnpm --filter './packages/**' --if-present run build",
    "memory": "node scripts/project-memory.mjs",
    "memory:update": "node scripts/update-project-memory-toolkit.mjs",
    "memory:wake": "node scripts/project-memory.mjs wake",
    "test:memory": "node --test scripts/project-memory.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:effect": "node scripts/run-effect-diagnostics.mjs",
    "lint": "pnpm lint:code && pnpm check:duplicates",
    "lint:code": "node scripts/run-quality-lint.mjs",
    "lint:fix": "node scripts/run-quality-lint.mjs --fix",
    "format": "node scripts/run-quality-lint.mjs --fix",
    "check:format": "pnpm lint:code",
    "check:circular": "dpdm --no-warning --no-tree --no-progress --exit-code circular:1 --transform 'src/**/*.ts' 'packages/**/*.ts' 'scripts/**/*.ts'",
    "check:complexity": "node scripts/check-oxlint-complexity.mjs",
    "check:complexity:prune": "node scripts/check-oxlint-complexity.mjs --prune",
    "check:duplicates": "jscpd .",
    "check:lab": "pnpm --filter @dalph/reducer-lab-prototype check",
    "check:package-boundary": "node scripts/check-package-boundaries.mjs",
    "check:quint": "node scripts/check-quint-models.mjs",
    "check:secrets": "gitleaks git --redact --no-banner",
    "test": "vitest run",
    "test:coverage": "vitest run --mode coverage --reporter=dot --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=json && node scripts/verify-coverage-summary.mjs && node scripts/verify-changed-coverage.mjs",
    "test:mbt": "vitest run --mode mbt",
    "test:watch": "vitest",
    "check:ci": "node scripts/run-quality-gate.mjs --without-quint",
    "check:all": "node scripts/run-quality-gate.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "node scripts/run-quality-lint.mjs --staged --fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "fs-ext-extra-prebuilt",
      "msgpackr-extract",
      "unrs-resolver",
      "dprint"
    ],
    "patchedDependencies": {
      "@firfi/quint-connect@2.0.2-effect4.1": "patches/@firfi__quint-connect@2.0.2-effect4.1.patch"
    }
  },
  "devDependencies": {
    "@dalph/contracts": "workspace:*",
    "@dalph/dalph": "workspace:*",
    "@dalph/orchestrator": "workspace:*",
    "@effect/tsgo": "0.24.3",
    "@effect/vitest": "4.0.0-beta.106",
    "@firfi/quint-connect": "2.0.2-effect4.1",
    "@informalsystems/quint": "0.32.0",
    "@types/node": "26.1.1",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "dpdm": "4.2.0",
    "dprint": "0.55.2",
    "effect": "4.0.0-beta.106",
    "eslint": "9.39.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-functional": "9.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-x": "4.16.1",
    "fast-check": "4.9.0",
    "husky": "9.1.7",
    "jscpd": "5.0.14",
    "lint-staged": "17.3.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "zod": "4.1.12"
  }
}
