{
  "name": "@dalph/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^24.20.0",
    "pnpm": ">=10.29.0"
  },
  "scripts": {
    "prepare": "husky && effect-tsgo patch --typescript-package @typescript/native",
    "build": "pnpm --filter './packages/**' run build",
    "bootstrap:worktree": "node scripts/bootstrap-worktree.mjs",
    "prewarm:vitest": "node scripts/prewarm-vitest.mjs",
    "test:preflight": "node --test --test-reporter=./scripts/compact-node-test-reporter.mjs scripts/preflight-census.test.mjs scripts/quality-lint-census.test.mjs scripts/candidate-secret-history.test.mjs scripts/quality-check-selection.test.mjs scripts/candidate-checks.test.mjs",
    "test:ci-change-classification": "node --test --test-reporter=./scripts/compact-node-test-reporter.mjs scripts/classify-docs-only-change.test.mjs",
    "typecheck": "node scripts/run-clean-typecheck.mjs",
    "typecheck:effect": "node scripts/run-effect-diagnostics.mjs",
    "typecheck:effect:changed": "node scripts/run-effect-diagnostics.mjs --changed",
    "lint": "pnpm lint:code",
    "lint:code": "node scripts/run-quality-lint.mjs",
    "lint:fix": "node scripts/run-quality-lint.mjs --fix",
    "lint:changed": "node scripts/run-quality-lint.mjs --changed",
    "format": "node scripts/run-quality-lint.mjs --fix",
    "check:format": "pnpm lint:code",
    "check:circular": "dpdm --no-warning --no-tree --no-progress --exit-code circular:1 --transform 'src/**/*.ts' 'packages/**/*.ts' 'scripts/**/*.ts'",
    "check:complexity": "node scripts/check-oxlint-complexity.mjs",
    "check:complexity:prune": "node scripts/check-oxlint-complexity.mjs --prune",
    "check:unused-exports": "node scripts/check-unused-exports.mjs",
    "gate:status": "node scripts/gate-run-status.mjs",
    "gate:reconcile": "node scripts/reconcile-gate-run.mjs",
    "gate:recovery": "node scripts/show-gate-recovery.mjs",
    "gate:diagnose": "node scripts/with-gate-slot.mjs -- node scripts/run-gate-diagnosis.mjs",
    "gate:verify-repair": "node scripts/with-gate-slot.mjs -- node scripts/run-gate-repair-verification.mjs",
    "test:gate-custody": "node --test --test-reporter=./scripts/compact-node-test-reporter.mjs scripts/gate-deadline.test.mjs scripts/gate-recovery.test.mjs scripts/gate-custody.test.mjs",
    "test:gate-previous-boot-reconcile": "node --test --test-reporter=./scripts/compact-node-test-reporter.mjs scripts/gate-previous-boot-reconcile.test.mjs",
    "test:gate-resume": "node --test --test-reporter=./scripts/compact-node-test-reporter.mjs scripts/gate-resume-policy.test.mjs scripts/gate-quality-evidence.test.mjs scripts/local-formal-relevance.test.mjs scripts/gate-resume-integration.test.mjs scripts/gate-resume-inputs.test.mjs scripts/gate-vite-cache.test.mjs scripts/prewarm-vitest.test.mjs scripts/gate-pnpm-state.test.mjs scripts/compact-node-test-reporter.test.mjs scripts/quality-output-budget.test.mjs scripts/quality-gate-qualification-scheduler.test.mjs",
    "check:preflight": "node scripts/with-gate-slot.mjs -- node scripts/run-preflight.mjs",
    "check:fast": "pnpm typecheck && pnpm lint:changed && node scripts/check-quality-selection-fixtures.mjs",
    "check:submit": "pnpm check:fast && pnpm lint:code --census",
    "check:baseline": "node scripts/with-gate-slot.mjs -- node scripts/run-baseline.mjs",
    "check:duplicates": "jscpd .",
    "test:capability-registration": "DALPH_RUN_QUALIFICATION_TESTS=1 vitest run scripts/capability-registration.test.ts",
    "test:delivery-repeatability": "node scripts/run-delivery-repeatability.mjs",
    "test:delivery-repeatability:warm": "node scripts/run-delivery-repeatability.mjs --mode=warm",
    "test:public-recovery": "vitest run packages/dalph/src/application/production-public-recovery.integration.test.ts --maxWorkers=1",
    "test:recorded-catalog": "DALPH_RUN_QUALIFICATION_TESTS=1 vitest run packages/dalph/test/cassettes/recorded-catalog-coverage.test.ts",
    "test:cassettes:memory": "vitest run packages/dalph/test/cassettes --maxWorkers=4",
    "test:integration:publication": "pnpm --filter @dalph/dalph... build && DALPH_RUN_PUBLICATION_INTEGRATION=1 vitest run packages/dalph/test/integration/direct-remote-publication.integration.test.ts --maxWorkers=1",
    "test:integration:capstone": "DALPH_RUN_INTEGRATION_CAPSTONE=1 vitest run packages/dalph/test/cassettes/capstone.execution.test.ts packages/dalph/test/cassettes/authored-delivery-status.test.ts packages/dalph/test/cassettes/recorded-catalog-coverage.test.ts --maxWorkers=1",
    "check:lab": "pnpm --filter @dalph/reducer-lab-prototype check",
    "check:lab:browser": "pnpm --filter @dalph/reducer-lab-prototype check:browser",
    "check:lab:browser:causal": "pnpm --filter @dalph/reducer-lab-prototype check:browser:causal",
    "check:lab:browser:capstone": "pnpm --filter @dalph/reducer-lab-prototype check:browser:capstone",
    "check:package-boundary": "node scripts/check-package-boundaries.mjs",
    "check:artifacts": "node scripts/workspace-artifacts.mjs",
    "check:quint": "node scripts/with-gate-slot.mjs -- node scripts/run-formal-gate.mjs",
    "check:secrets": "gitleaks git --redact --no-banner",
    "qualify:codex": "node scripts/qualify-codex-app-server.mjs",
    "qualify:production-live": "node scripts/run-production-live-qualification.mjs",
    "test:codex-integrator-qualification": "pnpm --filter @dalph/dalph... build && DALPH_RUN_REAL_CODEX_QUALIFICATION=1 vitest run packages/dalph/src/application/codex-integrator-real-qualification.test.ts --pool=forks",
    "test": "node scripts/run-tests.mjs",
    "coverage:explain": "node scripts/explain-coverage.mjs",
    "test:coverage:explanation": "node --test --test-reporter=./scripts/compact-node-test-reporter.mjs scripts/explain-coverage.test.mjs scripts/changed-files.test.mjs scripts/coverage-advisory.test.mjs",
    "coverage:body": "vitest run --mode coverage --reporter=dot --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=json && node scripts/verify-coverage-summary.mjs && node scripts/verify-changed-coverage.mjs",
    "test:coverage": "pnpm test",
    "test:mbt": "vitest run --mode mbt",
    "test:watch": "vitest",
    "check:ci:quality": "node scripts/with-gate-slot.mjs -- node scripts/run-quality-gate.mjs --hosted-quality",
    "check:ci:quality:preflight": "pnpm check:preflight",
    "check:ci:quality:stage": "node scripts/run-hosted-quality-stage.mjs",
    "check:ci:quality:aggregate": "node scripts/aggregate-hosted-quality-stages.mjs",
    "check:ci:formal": "node scripts/with-gate-slot.mjs -- node scripts/check-quint-models.mjs",
    "check:ci:formal:shard": "node scripts/with-gate-slot.mjs -- node scripts/run-hosted-formal-shard.mjs",
    "check:ci": "pnpm check:ci:quality && pnpm check:ci:formal",
    "check:all": "node scripts/with-gate-slot.mjs -- node scripts/run-candidate-checks.mjs",
    "test:formal:controls": "node --test --test-reporter=./scripts/compact-node-test-reporter.mjs scripts/formal-input-policy.test.mjs scripts/formal-success-evidence.test.mjs scripts/formal-progress-events.test.mjs scripts/generate-formal-command-inventory.test.mjs scripts/quint-effective-profile.test.mjs scripts/quint-affected-selection.test.mjs scripts/quint-owned-server.test.mjs scripts/quint-owned-client-patch.test.mjs scripts/quality-command-routing.test.mjs scripts/run-formal-workflow.test.mjs",
    "test:formal:integration": "node --test --test-reporter=./scripts/compact-node-test-reporter.mjs scripts/formal-gate.integration.test.mjs",
    "test:delivery-smoke": "node scripts/run-delivery-smoke.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "node scripts/run-quality-lint.mjs --staged --fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "fs-ext-extra-prebuilt",
      "msgpackr-extract",
      "unrs-resolver",
      "dprint"
    ],
    "patchedDependencies": {
      "@firfi/quint-connect@2.0.2-effect4.1": "patches/@firfi__quint-connect@2.0.2-effect4.1.patch",
      "@informalsystems/quint@0.32.0": "patches/@informalsystems__quint@0.32.0.patch"
    }
  },
  "devDependencies": {
    "@dalph/contracts": "workspace:*",
    "@dalph/dalph": "workspace:*",
    "@dalph/orchestrator": "workspace:*",
    "@effect/tsgo": "0.24.3",
    "@effect/vitest": "4.0.0-beta.106",
    "@firfi/quint-connect": "2.0.2-effect4.1",
    "@informalsystems/quint": "0.32.0",
    "@openai/codex": "0.149.0",
    "@types/node": "26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "acorn": "8.18.0",
    "dpdm": "4.2.0",
    "dprint": "0.55.2",
    "effect": "4.0.0-beta.106",
    "fast-check": "4.9.0",
    "husky": "9.1.7",
    "jscpd": "5.0.14",
    "knip": "6.37.0",
    "lint-staged": "17.3.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "zod": "4.1.12"
  }
}
