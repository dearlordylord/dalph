{
  "compilerOptions": {
    "allowJs": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "exactOptionalPropertyTypes": true,
    "incremental": true,
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "lazyEffect": "off"
        },
        "ignoreEffectWarningsInTscExitCode": true,
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "floatingEffect": "error"
              }
            }
          },
          {
            "include": ["packages/**/*.test.ts", "packages/**/*.spec.ts", "test/**/*.test.ts", "test/**/*.spec.ts"],
            "options": {
              "diagnosticSeverity": {
                "multipleEffectProvide": "off",
                "unnecessaryEffectGen": "off"
              }
            }
          }
        ]
      }
    ],
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/test/fixtures/**"
  ]
}
