{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@dalph/contracts": ["./packages/contracts/src/index.ts"],
      "@dalph/dalph": ["./packages/dalph/src/index.ts"],
      "@dalph/orchestrator": ["./packages/orchestrator/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/test/fixtures/**"
  ]
}
